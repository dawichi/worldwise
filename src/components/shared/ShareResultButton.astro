---
import { Share2 } from "lucide-astro";

interface Props {
    label: string;
}

const { label } = Astro.props;
---

<div class="flex flex-col items-center gap-2">
    <button
        id="share-result"
        type="button"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-button border border-border bg-surface px-5 py-3 text-sm font-bold text-accent-text"
    >
        <Share2 width={17} height={17} aria-hidden="true" />
        {label}
    </button>
    <span id="share-status" class="min-h-5 text-sm text-text-muted" role="status" aria-live="polite"></span>
</div>
