---
import { ArrowLeft } from "lucide-astro";
import { type Locale, t } from "../../lib/i18n/t";
import FeedbackPanel from "../shared/FeedbackPanel.astro";
import RouteMap from "../shared/RouteMap.astro";
import CompassDial from "./CompassDial.astro";

interface Props {
    locale: Locale;
    backHref: string;
    backLabel: string;
    /** Build-time tier label; when omitted, the client fills `#tier-label`. */
    tierLabel?: string;
}

const { locale, backHref, backLabel, tierLabel } = Astro.props;
---

<main class="mx-auto max-w-xl px-5 py-8 sm:px-6 sm:py-10">
    <div class="mb-5 flex items-center justify-between">
        <a
            href={backHref}
            aria-label={backLabel}
            class="flex h-8 w-8 items-center justify-center rounded-button bg-chip text-text-muted"
        >
            <ArrowLeft width={18} height={18} aria-hidden="true" />
        </a>
        <span id="tier-label" class="text-sm font-bold text-text">{tierLabel}</span>
        <span id="round-counter" class="rounded-pill bg-chip px-3 py-1.5 text-sm font-bold text-text"></span>
    </div>

    <h1 id="compass-prompt" class="mb-4 text-lg font-bold text-text"></h1>

    <div class="mb-6 flex items-center gap-2.5">
        <span id="origin-chip" class="rounded-pill bg-chip px-3.5 py-1.5 text-sm font-bold text-text"></span>
        <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
        <span id="destination-chip" class="rounded-pill bg-chip px-3.5 py-1.5 text-sm font-bold text-text"></span>
    </div>

    <div class="mb-6 w-full">
        <CompassDial id="compass-dial" labelledById="compass-prompt" />
    </div>

    <button
        id="submit-answer"
        type="button"
        class="w-full rounded-button bg-accent-button py-3.5 text-base font-bold text-white"
    >
        {t(locale, "common.submitAnswer")}
    </button>

    <div class="mb-4">
        <FeedbackPanel id="feedback-panel" />
    </div>

    <RouteMap
        id="route-map"
        label={t(locale, "compass.mapLabel")}
        legend={[
            { kind: "solid", label: t(locale, "compass.legendGreatCircle") },
            { kind: "dashed", label: t(locale, "compass.legendFlat") },
            { kind: "arrow", label: t(locale, "compass.legendArrow") },
        ]}
    />

    <button
        id="continue-round"
        type="button"
        class="hidden w-full rounded-button bg-accent-button py-3.5 text-base font-bold text-white"
    >
        {t(locale, "common.continue")}
    </button>
</main>
