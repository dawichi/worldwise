---
interface Props {
    id: string;
    /** id of the element that names what this dial answers (the round's prompt text). */
    labelledById: string;
}

const { id, labelledById } = Astro.props;
---

<div class="compass-dial-shell flex w-full flex-col items-center gap-3">
    <div
        id={id}
        class="compass-dial relative w-full touch-none select-none overflow-hidden rounded-xl outline-none"
        style="height: clamp(260px, 52vw, 360px);"
        role="slider"
        tabindex="0"
        aria-valuemin="0"
        aria-valuemax="359"
        aria-valuenow="0"
        aria-valuetext=""
        aria-labelledby={labelledById}
    >
        <div data-role="flight-glow" class="pointer-events-none absolute inset-0"></div>
        <svg
            data-role="map-svg"
            viewBox="-20 -60 60 40"
            preserveAspectRatio="xMidYMid meet"
            class="pointer-events-none absolute inset-0 h-full w-full bg-sea"
            aria-hidden="true"
        >
            <g data-role="map-world" stroke-width="0.75"></g>
            <g data-role="map-context"></g>
        </svg>
        <svg viewBox="0 0 200 160" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
            <defs>
                <filter id="compass-arrow-shadow"><feDropShadow dx="0" dy="3" stdDeviation="3" flood-opacity=".22"></feDropShadow></filter>
            </defs>
            <circle cx="100" cy="80" r="64" fill="none" class="stroke-border" stroke-width=".7" stroke-dasharray="2 4"></circle>
            <circle cx="100" cy="80" r="42" fill="none" class="stroke-border" stroke-width=".5" stroke-dasharray="1 5"></circle>
            <circle cx="100" cy="80" r="4" class="fill-text"></circle>
            <g data-role="needle" transform="rotate(0 100 80)" filter="url(#compass-arrow-shadow)">
                <line x1="100" y1="80" x2="100" y2="20" stroke="var(--needle-color, var(--color-accent))" stroke-width="4" stroke-linecap="round"></line>
                <path d="M100 12 L91 28 L100 23 L109 28 Z" fill="var(--needle-color, var(--color-accent))"></path>
            </g>
            <g data-role="perfect-needle" class="hidden" transform="rotate(0 100 80)">
                <line x1="100" y1="80" x2="100" y2="26" stroke="var(--color-success-icon)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="4 4"></line>
                <path d="M100 19 L95 29 L100 26 L105 29 Z" fill="var(--color-success-icon)"></path>
            </g>
        </svg>
        <div class="pointer-events-none absolute inset-x-4 bottom-3 text-[10px] font-bold uppercase tracking-[.16em] text-text-muted">
            <span data-role="origin-label" class="absolute left-0 max-w-[42%] truncate">Origin</span>
            <span data-role="flight-destination" class="absolute right-0 max-w-[42%] truncate opacity-0 transition-opacity">Destination</span>
        </div>
    </div>
    <div data-role="value-readout" class="text-sm font-semibold text-text-muted" aria-hidden="true">&nbsp;</div>
</div>

<style>
    .compass-dial:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
    }
    .compass-dial-shell {
        min-width: 0;
    }
    .compass-dial[aria-disabled="true"] {
        opacity: 0.6;
    }
    .compass-dial[data-revealed="true"] [data-role="flight-glow"] {
        animation: compass-flight-glow 1.8s ease-out both;
    }
    .compass-dial[data-revealed="true"] [data-role="flight-destination"] {
        opacity: 1;
    }
    .compass-dial[data-revealed="true"] [data-role="origin-map"] {
        animation: compass-map-pulse 1.8s ease-out both;
    }
    @keyframes compass-flight-glow {
        0% { opacity: 0; transform: scale(.55); background: radial-gradient(circle, var(--needle-color) 0, transparent 55%); }
        45% { opacity: .45; transform: scale(1); }
        100% { opacity: 0; transform: scale(1.25); }
    }
    @keyframes compass-map-pulse {
        0%, 100% { opacity: .75; }
        35% { opacity: 1; filter: drop-shadow(0 0 9px var(--needle-color)); }
    }
    @media (prefers-reduced-motion: reduce) {
        .compass-dial[data-revealed="true"] [data-role="flight-glow"],
        .compass-dial[data-revealed="true"] [data-role="origin-map"] { animation: none; }
    }
</style>
