---
import { ArrowLeft } from "lucide-astro";
import RouteBuilder from "../../components/borderRun/RouteBuilder.astro";
import FeedbackPanel from "../../components/shared/FeedbackPanel.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { parseDailyTierParam } from "../../lib/challenge/dailyTier";
import { localizedPath, pageLocale, t } from "../../lib/i18n/t";

const locale = pageLocale(Astro.currentLocale, Astro.url);
const tier = parseDailyTierParam(Astro.url.searchParams);
const tierLabel = t(locale, "borderRun.tierLabel", {
    tier: t(locale, `tiers.${tier}`),
});
---

<BaseLayout title={`${t(locale, "modes.borderRun.name")} — ${t(locale, "common.appName")}`}>
    <main class="mx-auto max-w-xl px-5 py-8 sm:px-6 sm:py-10">
        <div class="mb-5 flex items-center justify-between">
            <a
                href={localizedPath(locale, "/")}
                aria-label={t(locale, "common.backToToday")}
                class="flex h-8 w-8 items-center justify-center rounded-button bg-chip text-text-muted"
            >
                <ArrowLeft width={18} height={18} aria-hidden="true" />
            </a>
            <span class="text-sm font-bold text-text">{tierLabel}</span>
            <span id="round-counter" class="rounded-pill bg-chip px-3 py-1.5 text-sm font-bold text-text"></span>
        </div>

        <h1 id="border-run-prompt" class="mb-4 text-lg font-bold text-text"></h1>

        <RouteBuilder id="route-builder" />

        <button
            id="submit-answer"
            type="button"
            class="w-full rounded-button bg-accent-button py-3.5 text-base font-bold text-white"
        >
            {t(locale, "common.submitAnswer")}
        </button>

        <div class="mb-4">
            <FeedbackPanel id="feedback-panel" />
        </div>

        <button
            id="continue-round"
            type="button"
            class="hidden w-full rounded-button bg-accent-button py-3.5 text-base font-bold text-white"
        >
            {t(locale, "common.continue")}
        </button>
    </main>

    <script>
        import { mountBorderRunSession } from "../../client/borderRunSession";
        mountBorderRunSession();
    </script>
</BaseLayout>
