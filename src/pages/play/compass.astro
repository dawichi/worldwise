---
import CompassScreen from "../../components/compass/CompassScreen.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { parseDailyTierParam } from "../../lib/challenge/dailyTier";
import { localizedPath, pageLocale, t } from "../../lib/i18n/t";

const locale = pageLocale(Astro.currentLocale, Astro.url);
const tier = parseDailyTierParam(Astro.url.searchParams);
---

<BaseLayout title={`${t(locale, "modes.compass.name")} — ${t(locale, "common.appName")}`}>
    <CompassScreen
        locale={locale}
        backHref={localizedPath(locale, "/")}
        backLabel={t(locale, "common.backToToday")}
        tierLabel={t(locale, "compass.tierLabel", { tier: t(locale, `tiers.${tier}`) })}
    />

    <script>
        import { mountCompassSession } from "../../client/compassSession";
        mountCompassSession();
    </script>
</BaseLayout>
