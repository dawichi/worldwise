---
import CompassScreen from "../../components/compass/CompassScreen.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localizedPath, pageLocale, t } from "../../lib/i18n/t";

const locale = pageLocale(Astro.currentLocale, Astro.url);
---

<BaseLayout title={`${t(locale, "modes.compass.name")} — ${t(locale, "common.appName")}`}>
    <CompassScreen
        locale={locale}
        backHref={localizedPath(locale, "/practice")}
        backLabel={t(locale, "practice.backToPractice")}
    />

    <script>
        import { mountPracticeCompassSession } from "../../client/practiceCompassSession";
        mountPracticeCompassSession();
    </script>
</BaseLayout>
