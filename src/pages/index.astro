---
import { BarChart3, Compass, Route } from "lucide-astro";
import BonusTierRow from "../components/home/BonusTierRow.astro";
import ModeCard from "../components/home/ModeCard.astro";
import RitualProgress from "../components/home/RitualProgress.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageLocale, t } from "../lib/i18n/t";

const locale = pageLocale(Astro.currentLocale, Astro.url);
---

<BaseLayout title={t(locale, "common.appName")}>
    <main class="mx-auto max-w-xl px-5 py-8 sm:px-6 sm:py-10">
        <header class="mb-6 flex items-start justify-between">
            <div>
                <h1 class="text-xl font-extrabold text-text">{t(locale, "common.appName")}</h1>
                <div id="today-date" class="mt-0.5 text-sm text-text-muted"></div>
            </div>
            <div
                id="streak-chip"
                class="hidden items-center gap-1.5 rounded-pill bg-accent-tint px-3 py-1.5"
            >
                <span class="h-2 w-2 rounded-full bg-accent"></span>
                <span id="streak-count-text" class="text-sm font-bold text-accent-text"></span>
            </div>
        </header>

        <RitualProgress label={t(locale, "home.ritualProgress")} />

        <div class="flex flex-col gap-3">
            <ModeCard
                id="compass-mode-card"
                name={t(locale, "modes.compass.name")}
                statusLabel={t(locale, "home.notStarted")}
                startLabel={t(locale, "home.start")}
                href="/play/compass"
            >
                <Compass slot="icon" width={20} height={20} aria-hidden="true" />
            </ModeCard>

            <ModeCard
                id="arrange-mode-card"
                name={t(locale, "modes.arrange.name")}
                statusLabel={t(locale, "home.notStarted")}
                startLabel={t(locale, "home.start")}
                href="/play/arrange"
            >
                <BarChart3 slot="icon" width={20} height={20} aria-hidden="true" />
            </ModeCard>

            <ModeCard
                id="borderRun-mode-card"
                name={t(locale, "modes.borderRun.name")}
                statusLabel={t(locale, "home.notStarted")}
                startLabel={t(locale, "home.start")}
                href="/play/border-run"
            >
                <Route slot="icon" width={20} height={20} aria-hidden="true" />
            </ModeCard>
        </div>

        <div class="mt-6 flex flex-col gap-2.5 rounded-card border border-border bg-surface p-4">
            <span class="text-sm font-semibold text-text-muted">{t(locale, "home.bonusTiersLabel")}</span>
            <BonusTierRow
                id="compass-bonus-row"
                name={t(locale, "modes.compass.name")}
                href="/play/compass"
                easyLabel={t(locale, "tiers.easy")}
                hardLabel={t(locale, "tiers.hard")}
            />
            <BonusTierRow
                id="arrange-bonus-row"
                name={t(locale, "modes.arrange.name")}
                href="/play/arrange"
                easyLabel={t(locale, "tiers.easy")}
                hardLabel={t(locale, "tiers.hard")}
            />
            <BonusTierRow
                id="borderRun-bonus-row"
                name={t(locale, "modes.borderRun.name")}
                href="/play/border-run"
                easyLabel={t(locale, "tiers.easy")}
                hardLabel={t(locale, "tiers.hard")}
            />
        </div>

        <div class="mt-6 flex flex-col gap-2">
            <a href="/practice" class="text-sm font-semibold text-accent-text">{t(locale, "home.practiceLink")}</a>
            <a href="/statistics" class="text-sm font-semibold text-accent-text">{t(locale, "home.statisticsLink")}</a>
            <a href="/how-to-play" class="text-sm font-semibold text-accent-text">{t(locale, "nav.howToPlay")}</a>
            <a href="/settings" class="text-sm font-semibold text-accent-text">{t(locale, "nav.settings")}</a>
        </div>
    </main>

    <script>
        import { mountHome } from "../client/home";
        mountHome();
    </script>
</BaseLayout>
