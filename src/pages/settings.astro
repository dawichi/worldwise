---
import { ArrowLeft } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedPath, pageLocale, t } from "../lib/i18n/t";

const locale = pageLocale(Astro.currentLocale, Astro.url);
---

<BaseLayout title={`${t(locale, "settings.title")} — ${t(locale, "common.appName")}`}>
    <main class="mx-auto max-w-xl px-5 py-8 sm:px-6 sm:py-10">
        <div class="mb-7 flex items-center gap-3">
            <a
                href={localizedPath(locale, "/")}
                aria-label={t(locale, "common.backToToday")}
                class="flex h-8 w-8 items-center justify-center rounded-button bg-chip text-text-muted"
            >
                <ArrowLeft width={18} height={18} aria-hidden="true" />
            </a>
            <h1 class="text-lg font-bold text-text">{t(locale, "settings.title")}</h1>
        </div>

        <section class="mb-6 rounded-card border border-border bg-surface p-5" aria-labelledby="language-title">
            <h2 id="language-title" class="mb-1 text-base font-extrabold text-text">{t(locale, "settings.languageTitle")}</h2>
            <p class="mb-4 text-sm leading-relaxed text-text-muted">{t(locale, "settings.languageDescription")}</p>
            <label class="flex flex-col gap-2 text-sm font-semibold text-text" for="language-select">
                <span class="sr-only">{t(locale, "settings.languageTitle")}</span>
                <select id="language-select" class="min-h-11 rounded-button border border-border bg-surface px-3 text-text">
                    <option value="en" selected={locale === "en"}>{t(locale, "settings.english")}</option>
                    <option value="es" selected={locale === "es"}>{t(locale, "settings.spanish")}</option>
                </select>
            </label>
        </section>

        <section class="mb-6 rounded-card border border-border bg-surface p-5" aria-labelledby="motion-title">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 id="motion-title" class="mb-1 text-base font-extrabold text-text">{t(locale, "settings.reducedMotionTitle")}</h2>
                    <p class="text-sm leading-relaxed text-text-muted">{t(locale, "settings.reducedMotionDescription")}</p>
                </div>
                <label class="flex min-h-11 min-w-11 flex-shrink-0 items-center justify-center rounded-button bg-chip" for="reduced-motion">
                    <span class="sr-only">{t(locale, "settings.reducedMotionTitle")}</span>
                    <input id="reduced-motion" type="checkbox" class="h-5 w-5 accent-accent" />
                </label>
            </div>
        </section>

        <section class="rounded-card border border-border bg-surface p-5" aria-labelledby="data-title">
            <h2 id="data-title" class="mb-1 text-base font-extrabold text-text">{t(locale, "settings.dataTitle")}</h2>
            <p class="mb-4 text-sm leading-relaxed text-text-muted">{t(locale, "settings.dataDescription")}</p>
            <div class="flex flex-col gap-2 sm:flex-row">
                <button id="export-data" type="button" class="min-h-11 rounded-button border border-border px-4 py-2 text-sm font-bold text-accent-text">{t(locale, "settings.exportData")}</button>
                <button id="import-data" type="button" class="min-h-11 rounded-button border border-border px-4 py-2 text-sm font-bold text-accent-text">{t(locale, "settings.importData")}</button>
                <input id="import-file" type="file" accept="application/json,.json" aria-label={t(locale, "settings.importData")} class="sr-only" />
                <button id="reset-data" type="button" class="min-h-11 rounded-button bg-attention-bg px-4 py-2 text-sm font-bold text-attention-text">{t(locale, "settings.resetData")}</button>
            </div>
            <p id="settings-status" class="mt-3 min-h-5 text-sm text-text-muted" role="status" aria-live="polite"></p>
        </section>

        <a href={localizedPath(locale, "/about")} class="mt-5 block text-center text-sm font-semibold text-accent-text">{t(locale, "nav.about")}</a>
    </main>

    <script>
        import { mountSettings } from "../client/settings";
        mountSettings();
    </script>
</BaseLayout>
