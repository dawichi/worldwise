---
import "../styles/global.css";
import { type Locale, t } from "../lib/i18n/t";

interface Props {
    title: string;
}

const { title } = Astro.props;
const locale: Locale = Astro.currentLocale === "es" ? "es" : "en";
const description = t(locale, "common.metaDescription");
const ogImagePath = locale === "es" ? "/og-image-es.svg" : "/og-image.svg";
const ogImage = Astro.site
    ? new URL(ogImagePath, Astro.site).href
    : ogImagePath;
---

<html lang={locale}>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={t(locale, "common.appName")} />
        <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t(locale, "common.ogImageAlt")} />
        <meta name="twitter:card" content="summary_large_image" />
        <title>{title}</title>
        <script is:inline>
            try {
                const raw = localStorage.getItem("worldwise:preferences");
                const preferences = raw ? JSON.parse(raw) : null;
                const preferredLocale = preferences?.locale;
                const currentLocale = document.documentElement.lang;
                const url = new URL(window.location.href);
                const isSpanishPath = url.pathname === "/es" || url.pathname.startsWith("/es/");
                const basePath = isSpanishPath ? url.pathname.slice(3) || "/" : url.pathname;
                const preferredPath = preferredLocale === "es"
                    ? `/es${basePath === "/" ? "/" : basePath}`
                    : basePath;
                if ((preferredLocale === "en" || preferredLocale === "es") && preferredLocale !== currentLocale && url.pathname !== preferredPath) {
                    url.pathname = preferredPath;
                    window.location.replace(url.toString());
                }
                if (preferences?.reducedMotion === true) {
                    document.documentElement.classList.add("reduce-motion");
                }
            } catch {
                // Preferences are optional; the app remains usable with defaults.
            }
        </script>
    </head>
    <body class="min-h-screen">
        <slot />
    </body>
</html>
